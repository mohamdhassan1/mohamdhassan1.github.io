---
/**
 * Inline icon set. Kept as a local component rather than an icon package so
 * nothing extra ships and each glyph is only in the HTML that uses it.
 */
type IconName =
  | 'github'
  | 'linkedin'
  | 'mail'
  | 'download'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'code'
  | 'layers'
  | 'menu'
  | 'close'
  | 'check';

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: className = '', size = 16 } = Astro.props;

const paths: Record<IconName, string> = {
