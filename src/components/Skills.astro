---
import { skillGroups } from '../data/skills';
---

<section class="section skills" id="skills">
  <div class="container">
    <div class="skills__head reveal">
      <p class="eyebrow">Skills</p>
      <h2 class="section-title">The stack behind the work.</h2>
      <p class="section-lede">
        Grouped by what they are for, and labelled with the projects they actually appear in — so you can
        follow any of them straight into the source.
      </p>
    </div>

    <ul class="skills__grid">
      {
        skillGroups.map((group, i) => (
          <li class="card skills__card reveal" style={`--reveal-delay:${(i % 3) * 90}ms`}>
            <div class="skills__card-head">
              <h3 class="skills__title">{group.title}</h3>
              <p class="skills__seen">{group.seenIn}</p>
            </div>
            <ul class="badge-list">
              {group.items.map((item) => (
                <li class="badge">{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .skills {
    background:
      radial-gradient(ellipse 60% 40% at 50% 0%, rgba(127, 166, 255, 0.05), transparent 70%),
      var(--bg);
  }

  .skills__head {
    max-width: 52ch;
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .skills__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .skills__card-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .skills__title {
    font-size: var(--text-lg);
  }

  .skills__seen {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }

  .skills__card .badge {
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }

  .skills__card:hover .badge {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .skills__card .badge:hover {
    border-color: var(--border-accent);
    background: var(--accent-wash);
    color: var(--accent-bright);
  }
</style>
