---
import { site } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <p class="footer__name">{site.name}</p>
      <p class="footer__role">{site.title}</p>
      <p class="footer__location">{site.location}</p>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      <ul>
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer__socials">
      <a href={site.contact.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <Icon name="github" size={18} />
      </a>
      <a href={site.contact.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <Icon name="linkedin" size={18} />
      </a>
      <a href={`mailto:${site.contact.email}`} aria-label="Email">
        <Icon name="mail" size={18} />
      </a>
    </div>
  </div>

  <div class="container footer__base">
    <p>&copy; {year} {site.fullName}</p>
    <p class="footer__built">Built with Astro</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--surface-1);
    padding-block: var(--space-8) var(--space-6);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-6);
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .footer__role {
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }

  .footer__location {
    font-size: var(--text-sm);
    color: var(--text-subtle);
  }

  .footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-5);
  }

  .footer__nav a {
    font-size: var(--text-sm);
    color: var(--text-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__nav a:hover {
    color: var(--accent-bright);
  }

  .footer__socials {
    display: flex;
    gap: var(--space-3);
  }

  .footer__socials a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .footer__socials a:hover {
    color: var(--accent);
    border-color: var(--border-accent);
    transform: translateY(-2px);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }

  @media (min-width: 820px) {
    .footer__inner {
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      gap: var(--space-8);
    }
  }
</style>
