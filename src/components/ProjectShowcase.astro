---
import type { Project } from '../data/projects';
import ProjectMedia from './ProjectMedia.astro';
import Icon from './Icon.astro';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const flipped = index % 2 === 1;
const hasMedia = project.media.length > 0;
---

<article
  class:list={['showcase', flipped && 'showcase--flipped', project.caseStudy && 'showcase--case']}
  id={`project-${project.slug}`}
  aria-labelledby={`project-${project.slug}-title`}
>
  <div class="showcase__media reveal">
    {
      hasMedia ? (
        <ProjectMedia items={project.media} projectName={project.name} priority={index === 0} />
      ) : (
        /* No real capture exists for this project, so the slot shows the
           project's own mark and its stack instead of a mockup. */
        <div class="placeholder">
          {project.logo && (
            <img
              class="placeholder__logo"
              src={project.logo.src}
              alt={project.logo.alt}
              width="72"
              height="72"
              loading="lazy"
              decoding="async"
            />
          )}
          <p class="placeholder__name">{project.name}</p>
          <ul class="placeholder__stack">
            {project.stack.slice(0, 6).map((tech) => (
              <li class="badge">{tech}</li>
            ))}
          </ul>
          <p class="placeholder__note">
            <Icon name="code" size={13} />
            No captures available — see the note below
          </p>
        </div>
      )
    }
  </div>

  <div class="showcase__body">
    <div class="showcase__head reveal">
      <div class="showcase__meta">
        <span class="badge badge--accent">{project.category}</span>
        <span class="showcase__period">{project.period}</span>
      </div>

      <h3 class="showcase__title" id={`project-${project.slug}-title`}>{project.name}</h3>
      <p class="showcase__tagline">{project.tagline}</p>
    </div>

    <div class="showcase__prose reveal">
      <p>{project.problem}</p>
      <p>{project.solution}</p>
    </div>

    <div class="showcase__detail reveal">
      <h4 class="showcase__subhead">Key features</h4>
      <ul class="feature-list">
        {
          project.features.map((feature) => (
            <li>
              <Icon name="check" size={14} class="feature-list__icon" />
              <span>{feature}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="showcase__detail reveal">
      <h4 class="showcase__subhead">Technical highlights</h4>
      <dl class="tech-list">
        {
          project.technical.map((item) => (
            <div class="tech-list__row">
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="showcase__footer reveal">
      <div class="showcase__role">
        <span class="showcase__role-label">My role</span>
        <span>{project.role}</span>
      </div>

      <ul class="badge-list showcase__stack">
        {project.stack.map((tech) => <li class="badge">{tech}</li>)}
      </ul>

      {
        project.note && (
          <p class="showcase__note">
            <Icon name="code" size={14} class="showcase__note-icon" />
            <span>{project.note}</span>
          </p>
        )
      }

      {
        project.repo && (
          <a class="btn btn--ghost showcase__cta" href={project.repo} target="_blank" rel="noopener noreferrer">
            <Icon name="github" class="btn__icon" />
            View source
            <Icon name="arrow-up-right" class="btn__icon" />
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .showcase {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding-block: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--border);
  }

  /* Media */
  .showcase__media,
  .showcase__body {
    /* Grid children default to min-width:auto, which would let the horizontal
       screenshot scroller below stretch the whole page instead of scrolling. */
    min-width: 0;
  }

  /* Honest stand-in when no real capture exists */
  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    min-height: 300px;
    padding: var(--space-8) var(--space-5);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(ellipse 70% 60% at 50% 0%, rgba(127, 166, 255, 0.07), transparent 70%),
      var(--surface-1);
    text-align: center;
  }

  .placeholder__logo {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-lg);
    object-fit: contain;
  }

  .placeholder__name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .placeholder__stack {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    max-width: 22rem;
  }

  .placeholder__note {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }

  /* Body */
  .showcase__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .showcase__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .showcase__period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }

  .showcase__title {
    margin-top: var(--space-4);
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-tighter);
  }

  .showcase__tagline {
    margin-top: var(--space-2);
    color: var(--accent);
    font-size: var(--text-lg);
  }

  .showcase__prose {
    display: grid;
    gap: var(--space-4);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .showcase__subhead {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-subtle);
    margin-bottom: var(--space-4);
  }

  .feature-list {
    display: grid;
    gap: var(--space-3);
  }

  .feature-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-normal);
  }

  :global(.feature-list__icon) {
    flex: none;
    margin-top: 0.28em;
    color: var(--accent);
  }

  .tech-list {
    display: grid;
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--border);
    overflow: hidden;
  }

  .tech-list__row {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    background: var(--surface-1);
    transition: background var(--duration-fast) var(--ease-out);
  }

  .tech-list__row:hover {
    background: var(--surface-2);
  }

  .tech-list dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }

  .tech-list dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-normal);
  }

  /* Footer */
  .showcase__footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .showcase__role {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text);
  }

  .showcase__role-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .showcase__note {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-left: 2px solid var(--border-accent);
    border-radius: var(--radius-md);
    background: var(--surface-1);
    font-size: var(--text-sm);
    color: var(--text-subtle);
    line-height: var(--leading-normal);
  }

  :global(.showcase__note-icon) {
    flex: none;
    margin-top: 0.3em;
    color: var(--accent);
  }

  .showcase__cta {
    align-self: flex-start;
  }

  @media (min-width: 940px) {
    .showcase {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 5vw, 5rem);
      align-items: start;
    }

    .showcase--flipped .showcase__media {
      order: 2;
    }
  }
</style>
